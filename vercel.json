{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "https://agenticsl-learning-hub.onrender.com",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://agenticsl-learning-hub.onrender.com/:path*",
      "permanent": false
    }
  ]
}
